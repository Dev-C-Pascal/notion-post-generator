# Внутрішня інтеграція Notion: https://www.notion.so/profile/integrations -> New integration -> Internal Integration Secret
NOTION_TOKEN=secret_xxx
# Необов'язково: секрет для перевірки, що вебхук прийшов саме з твоєї Notion-автоматизації
WEBHOOK_SECRET=change-me

# Таблиця MVP на сторінці «Сomms product» — сюди бекенд створює рядки з постами
NOTION_DATABASE_ID=3de3973e-3325-80bb-a91b-cd1f7f3244ae
# Назви властивостей таблиці MVP
NOTION_PROP_DRAFT=Draft
NOTION_PROP_SOURCE=Source
NOTION_PROP_STATUS=Status

# Пароль окремої Postgres-бази драфтів (сервіс db у docker-compose). Згенерувати: openssl rand -hex 24
POSTGEN_DB_PASSWORD=change-me

# База Андрія (статті). Хост deploy-db-1 — контейнер зі стеку /opt/comms/deploy, пароль — POSTGRES_PASSWORD звідти.
# Без цієї змінної pipeline бере статті з data/articles.db (локально — порожня → тестова стаття).
# COMMS_DATABASE_URL=postgresql://comms:<password>@deploy-db-1:5432/comms

# Модель драфтів ML-команди (RunPod Serverless). Задані обидві → пост пише модель, інакше stub (пост = стаття).
# RUNPOD_ENDPOINT_ID=pfgumkt2rbrwfi
# RUNPOD_API_KEY=rpa_...
