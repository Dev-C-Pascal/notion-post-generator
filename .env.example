# Внутрішня інтеграція Notion: https://www.notion.so/profile/integrations -> New integration -> Internal Integration Secret
NOTION_TOKEN=secret_xxx
# Обов'язково: той самий, що в заголовку x-webhook-secret кнопок Notion. Порожній або change-me — бекенд не стартує.
# Згенерувати: openssl rand -hex 24
WEBHOOK_SECRET=change-me

# Таблиця MVP на сторінці «Сomms product» (воркспейс TM Space) — сюди бекенд створює рядки з постами
NOTION_DATABASE_ID=144d1fbd-7688-835c-b479-81680a5dbc0f
# Необов'язково: callout під кнопками на сторінці «Сomms product», куди бекенд пише, що з кожним натисканням
# (шукаю статтю / у черзі / генерується / готово / не вдалося). Не задано — рядка статусу немає.
NOTION_STATUS_BLOCK_ID=3e9d1fbd-7688-81bc-8572-df2997fac612
# Назви властивостей таблиці MVP
NOTION_PROP_DRAFT=Draft
NOTION_PROP_SOURCE=Source
NOTION_PROP_STATUS=Status

# Пароль окремої Postgres-бази драфтів (сервіс db у docker-compose). Згенерувати: openssl rand -hex 24
POSTGEN_DB_PASSWORD=change-me

# База Андрія: стаття береться з топу дня його векторного відбору (ml.daily_pick).
# Хост deploy-db-1 — контейнер зі стеку /opt/comms/deploy, пароль — POSTGRES_PASSWORD звідти.
# Без цієї змінної статей немає: прогін завершується, нічого не написавши.
# COMMS_DATABASE_URL=postgresql://comms:<password>@deploy-db-1:5432/comms

# Модель драфтів ML-команди (RunPod Serverless). Обовʼязкові: без них /health віддає 500.
RUNPOD_ENDPOINT_ID=pfgumkt2rbrwfi
RUNPOD_API_KEY=rpa_...
# Необов'язково: режим моделі. draft_grounded (за замовчуванням з 29.09) — пост лише з фактів, підтверджених
# цитатою зі статті; draft — стара генерація по всій статті (відкат без зміни коду).
# RUNPOD_MODE=draft_grounded
# Скільки генерацій одночасно (за замовчуванням 3). На сервері з 29.09 — 10 (стільки воркерів у ендпоінта).
# Кожна генерація draft_grounded ~5,5 ¢; 10 одночасно ≈ $7/год з балансу RunPod.
# MAX_PARALLEL_DRAFTS=10

# Health Check (див. CONTEXT.md §16–17). Прогін еталонного набору: POST 127.0.0.1:8000/health-check (лише з сервера).
# Тіло запиту (необов'язково): {"note": "змінили промпт"} — чому запускаємо; потрапить у звіт, рядок Notion і повідомлення.
# Необов'язково: раз на N днів запускати Health Check самостійно (не задано — лише вручну). Платно: ≈ $5,5 за прогін на
# RunPod + оцінка суддею. Прогін, що впав, розклад повторює один раз через добу.
# HEALTHCHECK_EVERY_DAYS=14
# Агент-оцінювач: оцінює драфти прогону інструкцією Антона (app/prompts/draft_eval_instruction.txt) на дешевій моделі
# Anthropic. Без ключа оцінки немає, прогін моделі працює як раніше. HEALTHCHECK_EVAL=0 вимикає оцінку і з ключем.
# ANTHROPIC_API_KEY=sk-ant-...
# HEALTHCHECK_JUDGE_MODEL=claude-haiku-5-5   # $0,10 / $0,50 за 1M токенів; ≈ $0,3–0,5 за оцінку 100 драфтів
# HEALTHCHECK_JUDGE_EFFORT=medium            # low | medium | high — глибина міркування судді
# HEALTHCHECK_JUDGE_MAX_TOKENS=16000
# HEALTHCHECK_JUDGE_PARALLEL=4
# HEALTHCHECK_JUDGE_PROMPT=/srv/data/draft_eval_instruction.txt   # інша інструкція (напр. якщо її не можна тримати в git)
# Вердикт (app/hc_verdict.py): «можна публікувати» (Fact safety ok + Style 4–5) від усіх 100 статей проти ОСТАННЬОГО
# УСПІШНОГО прогону. Впало більше за поріг — модель не пройшла. Поріг = max(THRESHOLD_PP, NOISE_PP): шум — різниця між
# двома прогонами тієї самої моделі, міряється командою python -m app.hc_flow noise <run_a> <run_b>.
# HEALTHCHECK_THRESHOLD_PP=5
# HEALTHCHECK_NOISE_PP=0
# Спостереження (на вердикт не впливають, лише показують, де шукати причину): інша метрика чи канал просіли на WARN_PP
# і знаковий тест дав p ≤ ALPHA_WARN.
# HEALTHCHECK_WARN_PP=8      HEALTHCHECK_ALPHA_WARN=0.2
# Звіт: GET 127.0.0.1:8000/health-check/runs/<id>/report. Якщо задано сторінку, бекенд сам створює під нею таблицю
# «Health Check — прогони» (один раз) і після кожного прогону додає рядок: дата, версія моделі, %, різниця, вердикт; тіло
# рядка — звіт. Звірка судді з людьми — підсторінкою тут же. Інтеграцію Notion підключити до сторінки («...» → Connections).
# Бекенд у Notion лише створює: наявного не змінює і не видаляє. Своя готова таблиця — NOTION_HEALTHCHECK_DATABASE_ID
# (пишуться лише ті колонки, що в ній є).
# NOTION_HEALTHCHECK_PAGE_ID=
# NOTION_HEALTHCHECK_DATABASE_ID=
# Прогін, з яким порівнюємо «прийняту» версію моделі (еталон; за замовчуванням — найстаріший завершений прогін).
# HEALTHCHECK_BASELINE_RUN=hc-...
# Повідомлення після кожного прогону (app/hc_alert.py, app/notify.py): журнал є завжди; Telegram і вебхук — за бажанням.
# Токен і chat_id — лише тут, у серверному .env, не в git і не в чатах.
# Перевірити, що доходить: curl -X POST 127.0.0.1:8000/health-check/alert-test -H "x-webhook-secret: $WEBHOOK_SECRET"
# HEALTHCHECK_ALERT_MODE=every               # every — після кожного прогону; failed — лише коли не пройшла / не визначено
# HEALTHCHECK_ALERT_TELEGRAM_BOT_TOKEN=      # від @BotFather; бот має бути в чаті (у групі — учасником)
# HEALTHCHECK_ALERT_TELEGRAM_CHAT_ID=        # число; у групи від'ємне -100…; або @username каналу
# HEALTHCHECK_ALERT_TELEGRAM_THREAD_ID=      # лише якщо в групі увімкнено теми
# HEALTHCHECK_ALERT_WEBHOOK=https://hooks.slack.com/services/...   # Slack / Mattermost / Discord: JSON із text і content
# Звірка судді з людськими оцінками (python -m app.hc_calibrate; POST/GET /health-check/calibration): ціль збігу по
# fact safety і кого згадати в повідомленні, якщо збіг нижчий (напр. @username Антона).
# HEALTHCHECK_CALIBRATION_TARGET=0.8
# HEALTHCHECK_CALIBRATION_MENTION=
