# DOMAIN береться з .env (наприклад posts.kse.ua). Caddy сам отримує сертифікат Let's Encrypt.
# Назовні — лише те, що потрібно кнопкам Notion, ручному запуску й моніторингу: /webhook*, /run, /health.
# Решта (/runs і /runs/{id} з текстами неопублікованих драфтів, /notion/check, /articles, /docs, /openapi.json)
# — лише з самого сервера: curl 127.0.0.1:8000/runs
{$DOMAIN} {
    @public path /health /run /webhook /webhook/*
    handle @public {
        reverse_proxy app:8000
    }
    handle {
        respond 404
    }
}
